{
  "name": "tp05-dashboard-telemetria",
  "version": "1.0.0",
  "private": true,
  "description": "Dashboard web de telemetría para robots Unitree (TP05 · Desarrollo de Aplicaciones II · UADE)",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "coverage:backend": "python -m pytest",
    "test:e2e": "node --test --test-concurrency=1 e2e/*.e2e.js",
    "test:all": "npm run coverage && npm run coverage:backend && npm run test:e2e",
    "mutation": "stryker run",
    "mutation:backend": "mutmut run --max-children 4; python tools/mutmut_html.py"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@vitest/coverage-v8": "5.1.0",
    "happy-dom": "21.0.4",
    "playwright": "1.48.2",
    "vitest": "5.1.0"
  }
}
